{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 820,
        "minHeight": 720,
        "minWidth": 820,
        "title": "My Life Logger",
        "width": 1080
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.harakazu.my-life-logger",
  "plugins": {
    "typegen": {
      "excludePatterns": null,
      "includePatterns": null,
      "includePrivate": false,
      "outputPath": "../src/generated",
      "projectPath": "../../",
      "typeMappings": {
        "DateTime<Utc>": "string",
        "NaiveDate": "string",
        "Uuid": "string",
        "ActivityId": "string",
        "CategoryId": "string"
      },
      "validationLibrary": "none",
      "verbose": false,
      "visualizeDeps": false
    }
  },
  "productName": "My Life Logger",
  "version": "0.1.0"
}
